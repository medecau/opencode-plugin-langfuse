{
  "name": "@pdbr/opencode-plugin-langfuse",
  "version": "2026.5.0",
  "description": "Langfuse observability plugin for OpenCode - LLM tracing and cost tracking via OpenTelemetry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "langfuse",
    "observability",
    "llm",
    "tracing",
    "ai"
  ],
  "author": "pdbr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medecau/opencode-plugin-langfuse.git"
  },
  "dependencies": {
    "@langfuse/otel": "4.5.1",
    "@opencode-ai/plugin": "1.1.14",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
